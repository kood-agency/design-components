{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "react", "typescript", "unicorn"],
  "categories": {
    "correctness": "deny",
    "suspicious": "deny",
    "perf": "deny"
  },
  "rules": {
    "eqeqeq": "deny",
    "no-console": "deny",
    "no-debugger": "deny",
    "no-var": "deny",
    "prefer-const": "deny",
    "react/react-in-jsx-scope": "off"
  },
  "overrides": [
    {
      "files": [".storybook/**/*", "**/*.css"],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    },
    {
      "files": ["src/hooks/**/*"],
      "rules": {
        "react/set-state-in-effect": "off"
      }
    }
  ],
  "ignorePatterns": ["dist/**", "storybook-static/**", "src/shadcn/**"]
}
